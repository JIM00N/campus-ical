# mac mini cron 전용 환경변수. 이 파일은 git에 안 올라간다 (.gitignore 처리됨).
# 실제 사용 시 .env로 복사 후 값 채울 것.

# Supabase Session pooler URL (prefix는 반드시 postgresql+psycopg://).
# Supabase 대시보드 > Connect > Session pooler 에서 받은 URI에서 prefix만 교체.
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# 크롤링할 미래 개월 수. 기본 4.
CRAWL_MONTHS_AHEAD=4
